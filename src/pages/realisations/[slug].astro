---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GalleryItem from '@/components/GalleryItem.astro';
import { getProjects, type Project } from '@/data/projects';
import { categoryLabel } from '@/data/services';
import { site } from '@/data/site';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, client, summary, categories, deliverables, year, cover, coverAlt, links, gallery } = project.data;
const { Content } = await render(project);
const pageUrl = new URL(`/realisations/${project.id}`, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    headline: `${title} · ${deliverables.join(', ')}`,
    description: summary,
    url: pageUrl,
    inLanguage: 'fr-BE',
    dateCreated: year.slice(0, 4),
    genre: categories.map(categoryLabel),
    keywords: deliverables.join(', '),
    creator: { '@type': 'Person', name: site.founder.name, url: new URL('/', Astro.site).href },
    publisher: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
    sourceOrganization: { '@type': 'Organization', name: client },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Réalisations', item: new URL('/#realisations', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={summary} image={cover} imageAlt={coverAlt} type="article" jsonLd={jsonLd}>
  <Header slot="header" />

  <article class="project">
    <header class="project__head column-wide">
      <nav class="crumbs" aria-label="Fil d’Ariane">
        <ol role="list">
          <li><a href="/">Accueil</a></li>
          <li><a href="/#realisations">Réalisations</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>
      <p class="project__tags">{categories.map(categoryLabel).join(' · ')}</p>
      <h1 class="project__title serif">{title}</h1>
      <p class="project__summary">{summary}</p>

      <dl class="project__facts">
        <div>
          <dt>Client</dt>
          <dd>{client}</dd>
        </div>
        <div>
          <dt>Année</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt>Prestations</dt>
          <dd>{deliverables.join(', ')}</dd>
        </div>
        {
          links.length > 0 && (
            <div>
              <dt>Liens</dt>
              <dd class="project__links">
                {links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="project__cover container">
      <Picture
        src={cover}
        alt={coverAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(max-width: 1240px) calc(100vw - 40px), 1200px"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="project__body column">
      <Content />
    </div>

    {
      gallery.length > 0 && (
        <section class="project__gallery container" aria-label={`Galerie du projet ${title}`}>
          {gallery.map((item) => (
            <GalleryItem {...item} />
          ))}
        </section>
      )
    }
  </article>

  <nav class="next container" aria-label="Projet suivant">
    <a class="next__link" href={`/realisations/${next.id}`}>
      <span class="next__label">Projet suivant</span>
      <span class="next__title serif">{next.data.title}</span>
      <span class="next__media">
        <Picture
          src={next.data.cover}
          alt=""
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(max-width: 720px) 100vw, 480px"
          loading="lazy"
        />
      </span>
    </a>
    <div class="next__actions">
      <a class="pill pill--lg" href="/#realisations">Toutes les réalisations</a>
      <a class="pill pill--primary pill--lg" href="/#contact">Démarrer un projet</a>
    </div>
  </nav>

  <Footer slot="footer" />
</Base>

<style>
  .column-wide {
    width: min(100% - var(--gutter) * 2, 52rem);
    margin-inline: auto;
  }

  .project__head {
    padding-top: calc(var(--header-h) + clamp(48px, 8vw, 96px));
    text-align: center;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: clamp(32px, 5vw, 56px);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--muted-2);
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .crumbs [aria-current] {
    color: var(--ink-80);
  }

  .project__tags {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--blue-600);
  }

  .project__title {
    margin-top: 12px;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .project__summary {
    max-width: 36rem;
    margin: clamp(20px, 3vw, 28px) auto 0;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--ink-60);
    text-wrap: balance;
  }

  .project__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px;
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    text-align: left;
  }

  .project__facts dt {
    margin-bottom: 4px;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .project__facts dd {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .project__links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--blue-700);
  }

  .project__cover {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .project__cover :global(img) {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--line), var(--shadow-card);
  }

  .project__body {
    padding-block: clamp(64px, 9vw, 120px);
    font-size: clamp(1.0625rem, 1.2vw, 1.1875rem);
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--ink-80);
  }

  .project__body :global(h2) {
    margin: 2.2em 0 0.6em;
    font-family: var(--font-serif);
    font-variation-settings: 'opsz' 144;
    font-size: clamp(1.625rem, 2.4vw, 2.125rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .project__body :global(h2:first-child) {
    margin-top: 0;
  }

  .project__body :global(p + p),
  .project__body :global(p + ul),
  .project__body :global(ul + p) {
    margin-top: 1em;
  }

  .project__body :global(ul) {
    display: grid;
    gap: 10px;
    margin-top: 1em;
    padding: 0;
    list-style: none;
  }

  .project__body :global(li) {
    position: relative;
    padding-left: 22px;
  }

  .project__body :global(li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue-500);
    box-shadow: 0 0 0 3px var(--sky-50);
  }

  .project__gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 32px);
  }

  .next {
    display: grid;
    justify-items: center;
    gap: 40px;
    padding-block: clamp(96px, 12vw, 160px) clamp(56px, 8vw, 96px);
    text-align: center;
  }

  .next__link {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .next__label {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .next__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    transition: color 0.4s var(--ease-out);
  }

  .next__media {
    width: min(100%, 480px);
    margin-top: 24px;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line), var(--shadow-card);
  }

  .next__media :global(img) {
    width: 100%;
    transition: transform 1.2s var(--ease-out);
  }

  .next__link:hover .next__title {
    color: var(--blue-600);
  }

  .next__link:hover .next__media :global(img) {
    transform: scale(1.04);
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
