---
import type { GetStaticPaths } from 'astro';
import { Image, Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import GalleryItem from '@/components/GalleryItem.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import StackIcon from '@/components/StackIcon.astro';
import Contact from '@/components/Contact.astro';
import { getProjects, type Project } from '@/data/projects';
import { categoryLabel } from '@/data/services';
import { site } from '@/data/site';
import { toolName } from '@/data/tools';
import { getReviews, initials } from '@/data/reviews';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      others: [1, 2, 3].map((step) => projects[(i + step) % projects.length]),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  others: Project[];
}

const { project, others } = Astro.props;
const { title, client, summary, categories, deliverables, year, industry, stack, icon, cover, coverAlt, links, gallery } =
  project.data;
const [primaryLink, ...secondaryLinks] = links;
const reviews = await getReviews();
const review = reviews.find((entry) => entry.project.id === project.id);
const contactIndex = String(reviews.length > 0 ? 8 : 7).padStart(2, '0');
const linkLabel = (label: string) => (label.includes('.') ? 'Voir le site' : `Voir sur ${label}`);
const { Content } = await render(project);
const pageUrl = new URL(`/realisations/${project.id}`, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    headline: `${title} · ${deliverables.join(', ')}`,
    description: summary,
    url: pageUrl,
    inLanguage: 'fr-BE',
    dateCreated: year.slice(0, 4),
    genre: categories.map(categoryLabel),
    keywords: [...deliverables, ...stack.map(toolName)].join(', '),
    about: industry.join(', '),
    creator: { '@type': 'Person', name: site.founder.name, url: new URL('/', Astro.site).href },
    publisher: { '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href },
    sourceOrganization: { '@type': 'Organization', name: client },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Réalisations', item: new URL('/#realisations', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---

<Base title={title} description={summary} image={cover} imageAlt={coverAlt} type="article" jsonLd={jsonLd}>
  <Header slot="header" />

  <article class="project">
    <header class="project__head narrow">
      <a class="project__back" href="/#realisations" aria-label="Retour aux réalisations">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M19 12H5m6-6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <span class:list={['project__icon', { 'project__icon--padded': icon?.padded }]} style={icon ? `background: ${icon.background}` : undefined}>
        {
          icon ? (
            <Image src={icon.src} alt="" width={128} height={Math.round((128 * icon.src.height) / icon.src.width)} loading="eager" />
          ) : (
            <Image src={cover} alt="" widths={[144, 288]} sizes="72px" loading="eager" />
          )
        }
      </span>

      <p class="project__tags">{categories.map(categoryLabel).join(' · ')}</p>
      <h1 class="project__title serif">{title}</h1>
      <p class="project__summary">{summary}</p>

      {
        primaryLink && (
          <div class="project__actions">
            <a class="pill pill--primary pill--lg" href={primaryLink.href} target="_blank" rel="noopener">
              {linkLabel(primaryLink.label)}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {secondaryLinks.map((link) => (
              <a class="pill pill--lg" href={link.href} target="_blank" rel="noopener">
                {link.label}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        )
      }

      <dl class="project__meta">
        <div>
          <dt>Prestations</dt>
          <dd>
            <ul role="list">
              {deliverables.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        {
          stack.length > 0 && (
            <div>
              <dt>Stack & outils</dt>
              <dd>
                <ul role="list" class="project__stack">
                  {stack.map((tool) => (
                    <li>
                      <StackIcon tool={tool} size={22} />
                      {toolName(tool)}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Secteur</dt>
          <dd>
            <ul role="list">
              {industry.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        <div>
          <dt>Année</dt>
          <dd>{year}</dd>
        </div>
      </dl>
    </header>

    <figure class="project__cover container">
      <Picture
        src={cover}
        alt={coverAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(max-width: 1240px) calc(100vw - 40px), 1200px"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="project__body narrow">
      <Content />
    </div>

    {
      review && (
        <figure class="project__review narrow">
          {review.placeholder && <span class="project__review-badge">Exemple</span>}
          <blockquote>
            <p>{review.quote}</p>
          </blockquote>
          <figcaption>
            <span class="project__review-avatar" aria-hidden="true">
              {initials(review.author)}
            </span>
            <span>
              <span class="project__review-name">{review.author}</span>
              <span class="project__review-role">{review.role}</span>
            </span>
          </figcaption>
        </figure>
      )
    }

    {
      gallery.length > 0 && (
        <section class="project__gallery container" aria-label={`Galerie du projet ${title}`}>
          {gallery.map((item) => (
            <GalleryItem {...item} />
          ))}
        </section>
      )
    }
  </article>

  <section class="more container" aria-labelledby="more-title">
    <div class="more__head">
      <h2 class="more__title" id="more-title">Autres réalisations</h2>
      <a class="pill" href="/#realisations">Tout voir</a>
    </div>
    <div class="more__grid">
      {others.map((other) => <ProjectCard project={other} />)}
    </div>
  </section>

  <Contact index={contactIndex} />

  <Footer slot="footer" />
</Base>

<script>
  import '@/scripts/reveal';
</script>

<style>
  .narrow {
    width: min(100% - var(--gutter) * 2, 40rem);
    margin-inline: auto;
  }

  .project__head {
    padding-top: calc(var(--header-total) + clamp(40px, 6vw, 72px));
  }

  .project__back {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: clamp(32px, 4vw, 44px);
    border-radius: 50%;
    background: #fff;
    color: var(--ink-80);
    box-shadow:
      0 0 0 1px var(--line),
      0 10px 24px -14px rgb(11 11 16 / 0.35);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .project__back:hover {
    transform: translateX(-3px);
    box-shadow:
      0 0 0 1px rgb(11 11 16 / 0.14),
      0 14px 28px -14px rgb(11 11 16 / 0.4);
  }

  .project__icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border-radius: 20px;
    background: var(--paper-2);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 34px -18px rgb(11 11 16 / 0.45);
  }

  .project__icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__icon--padded {
    padding: 14px;
  }

  .project__icon--padded :global(img) {
    object-fit: contain;
  }

  .project__tags {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .project__title {
    margin-top: 6px;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }

  .project__summary {
    margin-top: 20px;
    font-size: clamp(1.125rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--ink-60);
    text-wrap: pretty;
  }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .project__actions .pill {
    gap: 8px;
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    margin: clamp(48px, 6vw, 72px) 0 0;
  }

  .project__meta dt {
    margin-bottom: 12px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .project__meta dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  .project__meta ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__stack li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .project__cover {
    margin: clamp(56px, 8vw, 96px) auto 0;
    padding: clamp(16px, 4vw, 56px);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line) inset;
  }

  .project__cover :global(img) {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line), var(--shadow-card);
  }

  .project__body {
    padding-block: clamp(64px, 9vw, 112px);
    font-size: clamp(1.0625rem, 1.2vw, 1.125rem);
    line-height: 1.65;
    letter-spacing: -0.01em;
    color: var(--ink-80);
  }

  .project__body :global(h2) {
    margin: 2.4em 0 0.7em;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .project__body :global(h2:first-child) {
    margin-top: 0;
  }

  .project__body :global(p + p),
  .project__body :global(p + ul),
  .project__body :global(ul + p) {
    margin-top: 1em;
  }

  .project__body :global(ul) {
    display: grid;
    gap: 10px;
    margin-top: 1em;
    padding: 0;
    list-style: none;
  }

  .project__body :global(li) {
    position: relative;
    padding-left: 22px;
  }

  .project__body :global(li)::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  .project__review {
    position: relative;
    display: grid;
    gap: 28px;
    margin-bottom: clamp(64px, 9vw, 112px);
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
    box-shadow: 0 0 0 1px var(--line) inset;
  }

  .project__review blockquote {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .project__review blockquote p::before {
    content: '«\00a0';
  }

  .project__review blockquote p::after {
    content: '\00a0»';
  }

  .project__review figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .project__review-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .project__review-name,
  .project__review-role {
    display: block;
  }

  .project__review-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .project__review-role {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .project__review-badge {
    justify-self: start;
    margin-bottom: -8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #fff;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--muted);
    box-shadow: 0 0 0 1px var(--line);
  }

  .project__gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  .more {
    padding-top: clamp(96px, 12vw, 160px);
  }

  .more__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .more__title {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }

  @media (max-width: 900px) {
    .more__grid {
      grid-template-columns: 1fr;
    }

    .more__grid > :global(:nth-child(n + 3)) {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .project__meta {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }
  }
</style>
