---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
}

const { src } = Astro.props;
---

<div class="vignette" aria-hidden="true">
  <Image src={src} alt="" widths={[400, 600, 900, 1200]} sizes="(max-width: 720px) 90vw, 600px" loading="lazy" />
</div>

<style>
  .vignette {
    width: clamp(300px, 48vw, 600px);
    margin: 0 auto clamp(8px, 2vw, 24px);
    pointer-events: none;
  }

  .vignette :global(img) {
    width: 100%;
    animation: vignette-float 9s var(--ease-in-out) infinite alternate;
  }

  @keyframes vignette-float {
    from {
      transform: translateY(-6px);
    }
    to {
      transform: translateY(6px);
    }
  }
</style>
