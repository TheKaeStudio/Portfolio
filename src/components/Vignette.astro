
---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  type?: 'image' | 'video';
}

const { src, type = 'image' } = Astro.props;
---

<div class="vignette" aria-hidden="true">
  {type === 'video' ? (
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src={typeof src === 'string' ? src : src.src} type="video/webm" />
    </video>
  ) : (
    <Image
      src={src as ImageMetadata}
      alt=""
      widths={[400, 600, 900, 1200]}
      sizes="(max-width: 720px) 90vw, 600px"
      loading="lazy"
    />
  )}
</div>

<style>
  .vignette {
    width: clamp(240px, 48vw, 600px);
    max-width: 100%;
    margin: 0 auto clamp(8px, 2vw, 24px);
    pointer-events: none;
  }

  .vignette :global(img),
  .vignette video {
    display: block;
    width: 100%;
    height: auto;
    animation: vignette-float 9s var(--ease-in-out) infinite alternate;
  }

  @keyframes vignette-float {
    from {
      transform: translateY(-6px);
    }
    to {
      transform: translateY(6px);
    }
  }
</style>
