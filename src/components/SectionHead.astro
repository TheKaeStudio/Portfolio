---
interface Props {
  index: string;
  label: string;
  id?: string;
  align?: 'center' | 'start';
}

const { index, label, id, align = 'center' } = Astro.props;
---

<div class:list={['section-head', `section-head--${align}`]}>
  <span class="section-head__index" aria-hidden="true">{index}</span>
  <h2 class="section-head__label" id={id}>{label}</h2>
</div>

<style>
  .section-head {
    position: relative;
    display: grid;
    gap: 14px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .section-head--center {
    justify-items: center;
    text-align: center;
  }

  .section-head__index {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    line-height: 1;
    color: var(--muted-2);
  }

  .section-head--center .section-head__index {
    margin-left: -6em;
  }

  .section-head__label {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  .section-head--center .section-head__label::after {
    content: '';
    display: block;
    width: 3px;
    height: 3px;
    margin: 18px auto 0;
    border-radius: 50%;
    background: var(--muted-2);
  }
</style>
