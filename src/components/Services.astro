---
import SectionHead from '@/components/SectionHead.astro';
import { servicePills, services } from '@/data/services';
---

<section class="section services" aria-labelledby="services-title">
  <slot name="visual" />
  <div class="column centered">
    <SectionHead index="03" label="Mes services" id="services-title" />
    <p class="statement" data-reveal>
      La sélectivité est ma force : si je ne peux pas le faire à un niveau d’excellence, je ne le fais pas.
    </p>
  </div>

  <ul class="services__pills" role="list" aria-label="Services proposés">
    {
      servicePills.map((pill) => (
        <li>
          <a class="pill pill--lg" href={`#realisations`} data-filter-link={pill.category}>
            {pill.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="column centered">
    <p class="statement services__closing" data-reveal>
      Je ne prends que les projets que je peux livrer au plus haut niveau. <span class="soft">Pas de demi-mesure, pas de compromis.</span>
    </p>
  </div>

  <ol class="services__list" role="list">
    {
      services.map((service, i) => (
        <li class="service">
          <details class="service__details" name="services">
            <summary class="service__row">
              <span class="service__index" data-index={String(i + 1).padStart(2, '0')} aria-hidden="true" />
              <span class="service__body">
                <h3 class="service__title">{service.title}</h3>
                <span class="service__text">{service.description}</span>
              </span>
              <span class="service__toggle" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="service__panel">
              <div class="service__steps">
                <p class="service__label">Comment je travaille</p>
                <ol class="steps" role="list">
                  {service.steps.map((step, n) => (
                    <li class="step">
                      <span class="step__n" data-index={String(n + 1).padStart(2, '0')} aria-hidden="true" />
                      <span class="step__title">{step.title}</span>
                      <span class="step__text">{step.text}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="service__side">
                <p class="service__label">Formules</p>
                <ul class="formats" role="list">
                  {service.formats.map((format) => (
                    <li>{format}</li>
                  ))}
                </ul>
                <p class="service__label">Ce que vous recevez</p>
                <ul class="deliverables" role="list">
                  {service.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <div class="service__actions">
                  <a class="pill pill--primary" href="#contact">
                    Parler de mon projet
                  </a>
                  <a class="pill" href="#realisations" data-filter-link={service.category}>
                    Voir les projets
                  </a>
                </div>
              </div>
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .services__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 44rem;
    margin: clamp(40px, 6vw, 64px) auto;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .services__closing {
    margin-bottom: clamp(64px, 9vw, 120px);
  }

  .services__list {
    width: min(100% - var(--gutter) * 2, 52rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .service {
    border-bottom: 1px solid var(--line);
  }

  .service__details {
    interpolate-size: allow-keywords;
  }

  .service__details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.5s var(--ease-out),
      content-visibility 0.5s allow-discrete;
  }

  .service__details[open]::details-content {
    height: auto;
  }

  .service__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(24px, 3vw, 34px) clamp(8px, 1.5vw, 16px);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.45s var(--ease-out);
  }

  .service__row::-webkit-details-marker {
    display: none;
  }

  .service__index::before,
  .step__n::before {
    content: attr(data-index);
  }

  .service__index {
    align-self: start;
    padding-top: 0.45em;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--muted-2);
  }

  .service__body {
    display: grid;
    gap: 8px;
  }

  .service__title {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .service__text {
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-60);
  }

  .service__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pill);
    color: var(--ink);
    transition:
      background-color 0.45s var(--ease-out),
      color 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .service__row:hover {
    background: #f7f7f9;
  }

  .service__row:hover .service__toggle,
  .service__details[open] .service__toggle {
    background: var(--ink);
    color: #fff;
  }

  .service__details[open] .service__toggle {
    transform: rotate(45deg);
  }

  .service__panel {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    padding: 8px clamp(8px, 1.5vw, 16px) clamp(32px, 4vw, 48px) calc(3.5rem + clamp(16px, 3vw, 32px) + clamp(8px, 1.5vw, 16px));
  }

  .service__label {
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    column-gap: 12px;
    padding-bottom: 18px;
  }

  .step::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 1.9rem;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }

  .step:last-child::before {
    display: none;
  }

  .step__n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--pill);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--ink-80);
  }

  .step__title {
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .step__text {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-60);
  }

  .service__side {
    display: flex;
    flex-direction: column;
  }

  .formats {
    display: grid;
    gap: 8px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .formats li {
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--paper-2);
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--ink-80);
  }

  .deliverables {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .deliverables li {
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: 0 0 0 1px var(--line) inset;
    font-size: 0.8125rem;
    color: var(--ink-80);
  }

  .service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
  }

  @media (max-width: 860px) {
    .service__panel {
      grid-template-columns: 1fr;
      padding-left: clamp(8px, 1.5vw, 16px);
    }
  }

  @media (max-width: 560px) {
    .services__pills {
      gap: 8px;
    }

    .services__pills .pill--lg {
      min-height: 36px;
      padding: 0 14px;
      font-size: 0.8125rem;
    }

    .service__row {
      grid-template-columns: 2.25rem 1fr auto;
    }

    .service__text {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .service__row {
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    .service__index {
      display: none;
    }

    .service__title {
      font-size: 1.25rem;
    }
  }
</style>
