---
import SectionHead from '@/components/SectionHead.astro';
import { servicePills, services } from '@/data/services';
---

<section class="section services" aria-labelledby="services-title">
  <slot name="visual" />
  <div class="column centered">
    <SectionHead index="03" label="Mes services" id="services-title" />
    <p class="statement" data-reveal>
      La sélectivité est ma force : si je ne peux pas le faire à un niveau d’excellence, je ne le fais pas.
    </p>
  </div>

  <ul class="services__pills" role="list" aria-label="Services proposés">
    {
      servicePills.map((pill) => (
        <li>
          <a class="pill pill--lg" href={`#realisations`} data-filter-link={pill.category}>
            {pill.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="column centered">
    <p class="statement services__closing" data-reveal>
      Je ne prends que les projets que je peux livrer au plus haut niveau. <span class="soft">Pas de demi-mesure, pas de compromis.</span>
    </p>
  </div>

  <ol class="services__list" role="list">
    {
      services.map((service, i) => (
        <li class="service">
          <a class="service__row" href="#realisations" data-filter-link={service.category}>
            <span class="service__index" data-index={String(i + 1).padStart(2, '0')} aria-hidden="true" />
            <span class="service__body">
              <h3 class="service__title">{service.title}</h3>
              <span class="service__text">{service.description}</span>
            </span>
            <span class="service__arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="sr-only">Voir les projets {service.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .services__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 44rem;
    margin: clamp(40px, 6vw, 64px) auto;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .services__closing {
    margin-bottom: clamp(64px, 9vw, 120px);
  }

  .services__list {
    width: min(100% - var(--gutter) * 2, 52rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .service {
    border-bottom: 1px solid var(--line);
  }

  .service__row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(24px, 3vw, 34px) clamp(8px, 1.5vw, 16px);
    border-radius: var(--radius);
    transition:
      background-color 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .service__index::before {
    content: attr(data-index);
  }

  .service__index {
    align-self: start;
    padding-top: 0.45em;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--blue-500);
  }

  .service__body {
    display: grid;
    gap: 8px;
  }

  .service__title {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
    transition: color 0.45s var(--ease-out);
  }

  .service__text {
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-60);
  }

  .service__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--pill);
    color: var(--blue-700);
    transition:
      background-color 0.45s var(--ease-out),
      color 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .service__row:hover,
  .service__row:focus-visible {
    background: var(--sky-50);
  }

  .service__row:hover .service__title,
  .service__row:focus-visible .service__title {
    color: var(--blue-700);
  }

  .service__row:hover .service__arrow,
  .service__row:focus-visible .service__arrow {
    background: linear-gradient(180deg, var(--blue-500), var(--blue-600));
    color: #fff;
    transform: rotate(45deg);
  }

  @media (max-width: 560px) {
    .services__pills {
      gap: 8px;
    }

    .services__pills .pill--lg {
      min-height: 36px;
      padding: 0 14px;
      font-size: 0.8125rem;
    }

    .service__row {
      grid-template-columns: 2.25rem 1fr;
    }

    .service__arrow {
      display: none;
    }
  }
</style>
