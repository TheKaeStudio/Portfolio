---
import { Picture } from 'astro:assets';
import sky from '@/assets/hero/sky.jpg';
import LogoMark from '@/components/LogoMark.astro';
import { site } from '@/data/site';
import '@fontsource/gilda-display/latin-400.css';
import '@fontsource/gilda-display/latin-ext-400.css';

const star =
  'M12 0c.6 6.6 5.4 11.4 12 12-6.6.6-11.4 5.4-12 12-.6-6.6-5.4-11.4-12-12C6.6 11.4 11.4 6.6 12 0Z';

const { latitude, longitude, city, countryCode } = site.location;
const coords = `${latitude.toFixed(4)}° N, ${longitude.toFixed(4)}° E`;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__sky" data-parallax="0.35" aria-hidden="true">
    <Picture
      src={sky}
      alt=""
      formats={['avif', 'webp']}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </div>

  <div class="hero__emblem" data-parallax="0.15" aria-hidden="true">
    <div class="hero__halo"></div>
    <LogoMark size={120} class="hero__mark" />
  </div>

  <div class="hero__content" data-parallax="0.08">
    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">The Kae Studio</span>
      <span class="hero__the" aria-hidden="true">The</span>
      <span class="hero__name" aria-hidden="true"
        >Kae Stud<span class="hero__i"
          >ı<svg class="hero__tittle" viewBox="0 0 24 24"><path d={star} fill="#fff" /></svg></span
        >o</span
      >
      <span class="hero__shooting" aria-hidden="true">
        <span class="hero__trail"></span>
        <svg class="hero__comet" viewBox="0 0 24 24"><path d={star} fill="#fff" /></svg>
      </span>
      <svg class="hero__twinkle hero__twinkle--a" viewBox="0 0 24 24" aria-hidden="true"><path d={star} fill="#fff" /></svg>
      <svg class="hero__twinkle hero__twinkle--b" viewBox="0 0 24 24" aria-hidden="true"><path d={star} fill="#fff" /></svg>
    </h1>
    <p class="hero__subtitle">Artisan du numérique</p>
  </div>

  <div class="hero__footer" aria-hidden="true">
    <span>{coords}</span>
    <span class="hero__scroll">Défiler</span>
    <span>{city}, {countryCode}</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(640px, 100svh);
    overflow: hidden;
    color: #fff;
    background: linear-gradient(180deg, var(--blue-800), var(--blue-500) 60%, #fff);
  }

  .hero__sky {
    position: absolute;
    inset: -4% 0 -28%;
    z-index: -2;
    will-change: transform;
  }

  .hero__sky :global(picture),
  .hero__sky :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__sky :global(img) {
    object-fit: cover;
    object-position: 50% 30%;
    animation: drift 40s var(--ease-in-out) infinite alternate;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0), #fff);
    pointer-events: none;
  }

  .hero__emblem {
    position: absolute;
    top: clamp(96px, 16vh, 170px);
    left: 50%;
    width: 120px;
    margin-left: -60px;
    color: #fff;
    opacity: 0.95;
  }

  .hero__emblem :global(.hero__mark) {
    position: relative;
    filter: drop-shadow(0 0 18px rgb(255 255 255 / 0.55)) drop-shadow(0 10px 40px rgb(0 88 210 / 0.6));
    animation: float 7s var(--ease-in-out) infinite alternate;
  }

  .hero__halo {
    position: absolute;
    inset: -60%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.35), rgb(255 255 255 / 0) 70%);
    animation: pulse 7s var(--ease-in-out) infinite alternate;
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 18vh var(--gutter) 0;
    text-align: center;
  }

  .hero__title {
    --name-size: clamp(76px, 15vw, 228px);
    position: relative;
    display: grid;
    font-family: 'Gilda Display', var(--font-serif);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.015em;
  }

  .hero__the,
  .hero__name,
  .hero__subtitle {
    background: linear-gradient(180deg, #ffffff 15%, #d6ecff 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 0.014em #eef6ff;
    filter: drop-shadow(0 6px 28px rgb(6 42 115 / 0.35));
  }

  .hero__the {
    justify-self: start;
    margin-left: 0.55em;
    font-size: clamp(40px, 6vw, 84px);
  }

  .hero__name {
    font-size: var(--name-size);
    white-space: nowrap;
  }

  .hero__i {
    position: relative;
    display: inline-block;
  }

  .hero__tittle {
    position: absolute;
    left: 50%;
    top: 0.02em;
    width: 0.2em;
    height: 0.2em;
    transform: translateX(-50%);
    filter: drop-shadow(0 0 0.06em rgb(255 255 255 / 0.95));
    animation: twinkle 3.6s var(--ease-in-out) infinite;
  }

  .hero__shooting {
    position: absolute;
    right: -0.04em;
    top: -0.32em;
    width: 2.3em;
    height: 0.6em;
    font-size: var(--name-size);
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .hero__trail {
    position: absolute;
    right: 0.08em;
    top: 50%;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 255 255 / 0.9));
    transform-origin: right center;
    animation: shoot 7s var(--ease-out) infinite;
  }

  .hero__comet {
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.16em;
    height: 0.16em;
    transform: translate(40%, -50%);
    filter: drop-shadow(0 0 0.06em rgb(255 255 255 / 0.95));
    animation: twinkle 3.6s var(--ease-in-out) 1.2s infinite;
  }

  .hero__twinkle {
    position: absolute;
    width: 14px;
    height: 14px;
    filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.9));
    animation: twinkle 4.2s var(--ease-in-out) infinite;
  }

  .hero__twinkle--a {
    left: -4%;
    bottom: 6%;
    animation-delay: 0.8s;
  }

  .hero__twinkle--b {
    right: 8%;
    bottom: -12%;
    width: 9px;
    height: 9px;
    animation-delay: 2s;
  }

  .hero__subtitle {
    -webkit-text-stroke-width: 0.018em;
    margin-top: clamp(10px, 1.6vw, 22px);
    font-family: 'Gilda Display', var(--font-serif);
    font-size: clamp(26px, 3.6vw, 52px);
    letter-spacing: -0.005em;
    filter: drop-shadow(0 2px 16px rgb(6 42 115 / 0.55));
  }

  .hero__footer {
    position: absolute;
    inset: auto var(--gutter) 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--blue-700);
    opacity: 0.7;
  }

  .hero__scroll {
    position: relative;
    padding-bottom: 18px;
  }

  .hero__scroll::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 12px;
    background: currentColor;
    animation: scroll-cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes drift {
    from {
      transform: scale(1.04) translate3d(-1%, 0, 0);
    }
    to {
      transform: scale(1.08) translate3d(1%, -1%, 0);
    }
  }

  @keyframes float {
    from {
      transform: translateY(-6px) rotate(-2deg);
    }
    to {
      transform: translateY(8px) rotate(2deg);
    }
  }

  @keyframes pulse {
    from {
      opacity: 0.6;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
      scale: 1;
    }
    50% {
      opacity: 0.55;
      scale: 0.75;
    }
  }

  @keyframes shoot {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    12% {
      opacity: 1;
      transform: scaleX(1);
    }
    30%,
    100% {
      opacity: 0.85;
      transform: scaleX(1);
    }
  }

  @keyframes scroll-cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 640px) {
    .hero__sky {
      inset: -4% 0 -8%;
    }

    .hero__title {
      --name-size: min(96px, calc((100vw - 2 * var(--gutter)) / 5.1));
    }

    .hero__the {
      font-size: calc(var(--name-size) * 0.42);
    }

    .hero__subtitle {
      font-size: min(26px, calc((100vw - 2 * var(--gutter)) / 10.6));
    }

    .hero__content {
      padding-top: 12vh;
    }

    .hero__emblem {
      width: 84px;
      margin-left: -42px;
    }

    .hero__emblem :global(.hero__mark) {
      width: 84px;
      height: 84px;
    }

    .hero__footer span:not(.hero__scroll) {
      display: none;
    }

    .hero__footer {
      justify-content: center;
    }
  }
</style>
