---
import SectionHead from '@/components/SectionHead.astro';
import Skills from '@/components/Skills.astro';
import { Picture } from 'astro:assets';
import portrait from '@/assets/about/portrait.jpg';
import { site } from '@/data/site';
import { timeline } from '@/data/timeline';

interface Props {
  index?: string;
}

const { index = '06' } = Astro.props;
const github = site.socials.find((s) => s.label === 'GitHub');
const awards = timeline.find((g) => g.title === 'Distinctions')?.entries ?? [];
const groups = timeline.filter((g) => g.title !== 'Distinctions');
const leaves = Array.from({ length: 6 }, (_, i) => {
  const angle = 108 + i * 22;
  const rad = (angle * Math.PI) / 180;
  return { x: 32 + Math.cos(rad) * 21, y: 33 + Math.sin(rad) * 21, rotate: angle + 90 };
});
---

<section class="section about" id="parcours" aria-labelledby="about-title">
  <slot name="visual" />
  <div class="column centered">
    <SectionHead index={index} label="Qui suis-je" id="about-title" />
    <p class="statement" data-reveal>
      Un studio, une seule paire de mains.
    </p>
    <p class="prose about__lead" data-reveal>
      Tout ce que je crée passe entre mes mains. Pas de sous-traitance, pas de raccourcis. <span class="soft">Juste de la concentration et de l’exigence.</span>
    </p>
  </div>

  <div class="awards container">
    <h3 class="awards__title">Distinctions</h3>
    <ul class="awards__list" role="list">
      {
        awards.map((award) => (
          <li class:list={['award', `award--${award.award ?? 'nominee'}`]}>
            <div class="award__top">
              <span class="award__badge" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="56" height="56">
                  <g fill="currentColor">
                    {leaves.map((leaf) => (
                      <ellipse cx={leaf.x} cy={leaf.y} rx="2.8" ry="6.4" transform={`rotate(${leaf.rotate} ${leaf.x} ${leaf.y})`} />
                    ))}
                    {leaves.map((leaf) => (
                      <ellipse
                        cx={64 - leaf.x}
                        cy={leaf.y}
                        rx="3.2"
                        ry="7"
                        transform={`rotate(${-leaf.rotate} ${64 - leaf.x} ${leaf.y})`}
                      />
                    ))}
                    <path d="M32 21c.5 5.5 4.5 9.5 10 10-5.5.5-9.5 4.5-10 10-.5-5.5-4.5-9.5-10-10 5.5-.5 9.5-4.5 10-10Z" />
                  </g>
                </svg>
              </span>
              <span class="award__period">{award.period}</span>
            </div>
            <p class="award__kind">{award.award === 'winner' ? 'Lauréat' : 'Nommé'}</p>
            <p class="award__title">{award.title}</p>
            <p class="award__place">{award.place}</p>
            {award.description && <p class="award__desc">{award.description}</p>}
            {award.link && (
              <a class="award__link" href={award.link.href} target="_blank" rel="noopener">
                {award.link.label}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="timeline container">
    {
      groups.map((group) => (
        <div class="timeline__group">
          <h3 class="timeline__title">{group.title}</h3>
          <ol class="timeline__list" role="list">
            {group.entries.map((entry) => (
              <li class="timeline__entry">
                <span class="timeline__period">{entry.period}</span>
                <p class="timeline__role">{entry.title}</p>
                <p class="timeline__place">{entry.place}</p>
                {entry.description && <p class="timeline__desc">{entry.description}</p>}
                {entry.link && (
                  <a class="timeline__link" href={entry.link.href} target="_blank" rel="noopener">
                    {entry.link.label}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <Skills />

  <div class="profile">
    <div class="profile__avatar">
      <Picture
        src={portrait}
        alt={`Portrait de ${site.founder.name}`}
        formats={['avif', 'webp']}
        widths={[220, 440]}
        sizes="220px"
        loading="lazy"
        class="profile__photo"
      />
    </div>
    <p class="profile__name">{site.founder.name}</p>
    <p class="profile__role">Fondateur, designer & développeur</p>
    {
      github && (
        <a class="profile__social" href={github.href} target="_blank" rel="noopener me" aria-label="Profil GitHub de The Kae Studio">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </a>
      )
    }
  </div>

</section>

<style>
  .about__lead {
    margin-top: 18px;
  }

  .profile {
    display: grid;
    justify-items: center;
    gap: 4px;
    margin: clamp(80px, 11vw, 140px) auto 0;
    text-align: center;
  }

  .profile__avatar {
    position: relative;
    width: 220px;
    height: 220px;
    margin-bottom: 24px;
    border-radius: 50%;
    box-shadow:
      0 0 0 10px rgb(219 239 255 / 0.7),
      0 30px 60px -24px rgb(0 88 210 / 0.45);
  }

  .profile__avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(11 11 16 / 0.06) inset;
    pointer-events: none;
  }

  .profile__avatar :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile__name {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
  }

  .profile__role {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .profile__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-top: 18px;
    border-radius: 50%;
    background: var(--pill);
    color: var(--ink-80);
    box-shadow: var(--shadow-pill);
    transition: background-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .profile__social:hover {
    background: #e7e7ec;
    transform: translateY(-2px);
  }

  .awards {
    max-width: 68rem;
    margin-top: clamp(64px, 9vw, 112px);
  }

  .awards__title {
    margin-bottom: 20px;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .awards__list {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(16px, 2vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .award {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(24px, 3vw, 36px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    isolation: isolate;
  }

  .award--winner {
    color: #fff;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(0 183 254 / 0.9), rgb(0 183 254 / 0) 60%),
      linear-gradient(160deg, var(--blue-600), var(--blue-800));
    box-shadow: 0 30px 70px -34px rgb(0 88 210 / 0.8);
  }

  .award--winner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(255 255 255 / 0.55) 1px, transparent 1.4px);
    background-size: 46px 46px;
    mask-image: linear-gradient(200deg, #000, transparent 65%);
    opacity: 0.6;
  }

  .award--nominee {
    color: var(--ink);
    background: linear-gradient(160deg, var(--sky-50), #fff 70%);
    box-shadow:
      0 0 0 1px var(--blue-100) inset,
      0 24px 60px -36px rgb(0 88 210 / 0.45);
  }

  .award__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .award__badge {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
  }

  .award--winner .award__badge {
    color: #fff;
    background: rgb(255 255 255 / 0.14);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.3) inset;
  }

  .award--nominee .award__badge {
    color: var(--blue-600);
    background: #fff;
    box-shadow: 0 0 0 1px var(--blue-100);
  }

  .award__period {
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  .award--winner .award__period {
    background: rgb(255 255 255 / 0.16);
  }

  .award--nominee .award__period {
    background: #fff;
    color: var(--blue-700);
    box-shadow: 0 0 0 1px var(--blue-100);
  }

  .award__kind {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .award--nominee .award__kind {
    color: var(--blue-700);
  }

  .award__title {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .award__place {
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .award--nominee .award__place {
    color: var(--muted);
    opacity: 1;
  }

  .award__desc {
    margin-top: 10px;
    font-size: 0.9375rem;
    line-height: 1.55;
    opacity: 0.9;
  }

  .award--nominee .award__desc {
    color: var(--ink-60);
    opacity: 1;
  }

  .award__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: auto;
    padding-top: 18px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .award--nominee .award__link {
    color: var(--blue-700);
  }

  .timeline {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px);
    max-width: 68rem;
  }

  .timeline__title {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }

  .timeline__list {
    display: grid;
  }

  .timeline__entry {
    display: grid;
    gap: 4px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }

  .timeline__period {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--blue-600);
  }

  .timeline__role {
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .timeline__place {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .timeline__desc {
    margin-top: 6px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-60);
  }

  .timeline__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--blue-700);
  }

  @media (max-width: 900px) {
    .awards__list {
      grid-template-columns: 1fr;
    }

    .timeline {
      grid-template-columns: 1fr;
      max-width: 34rem;
    }
  }
</style>
