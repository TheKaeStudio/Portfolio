---
import type { ImageMetadata } from 'astro';
import { tools, type ToolId } from '@/data/tools';

interface Props {
  tool: ToolId;
  theme?: 'light' | 'dark';
  size?: number;
  class?: string;
}

const files = import.meta.glob<ImageMetadata>('../assets/stack/*.svg', { eager: true, import: 'default' });
const byName = new Map(Object.entries(files).map(([path, meta]) => [path.split('/').pop()!.replace('.svg', ''), meta]));

const { tool, theme = 'light', size = 24, class: className } = Astro.props;
const { icon } = tools[tool];
const meta = byName.get(`${icon}-${theme}`) ?? byName.get(icon);
---

{meta && <img class:list={['stack-icon', className]} src={meta.src} width={size} height={size} alt="" loading="lazy" decoding="async" />}

<style>
  .stack-icon {
    flex: none;
    border-radius: 24%;
  }
</style>
