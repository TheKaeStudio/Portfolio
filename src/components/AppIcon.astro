<style>
  .app-icon {
    display: inline-grid;
    width: var(--size);
    height: var(--size);
    filter: drop-shadow(0 calc(var(--size) * 0.12) calc(var(--size) * 0.16) rgb(42 34 168 / 0.35))
      drop-shadow(0 2px 3px rgb(29 23 115 / 0.2));
  }

  .app-icon svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
