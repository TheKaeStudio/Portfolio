---
import LogoMark from '@/components/LogoMark.astro';

interface Props {
  size?: number;
}

const { size = 88 } = Astro.props;
---

<div class="app-icon" style={`--size: ${size}px`} aria-hidden="true">
  <span class="app-icon__gloss"></span>
  <LogoMark size={Math.round(size * 0.56)} class="app-icon__mark" />
</div>

<style>
  .app-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.24);
    color: #fff;
    background:
      radial-gradient(120% 80% at 50% 0%, #8f8af7 0%, rgb(143 138 247 / 0) 55%),
      linear-gradient(180deg, #5d56ee 0%, #3b33c8 55%, #2a22a8 100%);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.45) inset,
      0 -8px 18px rgb(29 23 115 / 0.45) inset,
      0 18px 40px -14px rgb(42 34 168 / 0.65),
      0 40px 60px -30px rgb(106 100 236 / 0.6);
    -webkit-box-reflect: below 10px linear-gradient(transparent 55%, rgb(255 255 255 / 0.22));
  }

  .app-icon__gloss {
    position: absolute;
    inset: 4% 8% 50%;
    border-radius: calc(var(--size) * 0.2) calc(var(--size) * 0.2) 50% 50% / calc(var(--size) * 0.2)
      calc(var(--size) * 0.2) 30% 30%;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.45), rgb(255 255 255 / 0));
    pointer-events: none;
  }

  .app-icon :global(.app-icon__mark) {
    position: relative;
    filter: drop-shadow(0 2px 6px rgb(29 23 115 / 0.45));
  }
</style>
