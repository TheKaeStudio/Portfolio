---
import { Image } from 'astro:assets';
import appIcon from '@/assets/brand/app-icon.png';

interface Props {
  size?: number;
  class?: string;
}

const { size = 96, class: className } = Astro.props;
---

<div class:list={['app-icon', className]} style={`--size: ${size}px`} aria-hidden="true">
  <Image src={appIcon} alt="" width={size} height={size} densities={[1, 2, 3]} loading="lazy" />
</div>

<style>
  .app-icon {
    display: inline-grid;
    width: var(--size);
    height: var(--size);
    filter: drop-shadow(0 calc(var(--size) * 0.12) calc(var(--size) * 0.16) rgb(0 114 252 / 0.32))
      drop-shadow(0 2px 3px rgb(0 70 160 / 0.18));
  }

  .app-icon :global(img) {
    width: 100%;
    height: 100%;
  }
</style>
