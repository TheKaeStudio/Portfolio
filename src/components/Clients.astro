---
import SectionHead from '@/components/SectionHead.astro';
import AppIcon from '@/components/AppIcon.astro';
import { Image } from 'astro:assets';
import { clients } from '@/data/clients';
import { getProjects } from '@/data/projects';
import { categoryLabel } from '@/data/services';

const projects = new Map((await getProjects()).map((p) => [p.id, p]));
---

<section class="section clients" aria-labelledby="clients-title">
  <slot name="visual" />
  <div class="column centered">
    <SectionHead index="02" label="Ils m’ont fait confiance" id="clients-title" />
    <p class="statement" data-reveal>
      Des indépendants aux PME, j’accompagne des marques ambitieuses qui veulent se démarquer.
    </p>
  </div>

  <ul class="clients__grid container" role="list">
    {
      clients.map((client) => {
        const project = projects.get(client.project);
        const tags = project ? project.data.categories.map(categoryLabel).join(' · ') : '';
        return (
          <li class="clients__item">
            <a class="client" href={`/realisations/${client.project}`} aria-label={`${client.name}, voir le projet`}>
              <span class:list={['client__brand', `client__brand--${client.display}`]}>
                {client.display === 'logo' && <Image src={client.logo} alt="" height={52} class="client__logo" />}
                {client.display === 'icon' && <Image src={client.icon} alt="" height={26} class="client__icon" />}
                {client.display !== 'logo' && <span class="client__name">{client.name}</span>}
              </span>
              {project && (
                <span class="client__card" aria-hidden="true">
                  <Image src={project.data.cover} alt="" width={128} height={96} densities={[1, 2]} class="client__thumb" />
                  <span class="client__meta">
                    <span class="client__title">{client.name}</span>
                    <span class="client__tags">{tags}</span>
                  </span>
                </span>
              )}
              <span class="client__cta" aria-hidden="true">
                Voir le projet
              </span>
            </a>
          </li>
        );
      })
    }
    <li class="clients__item clients__item--more"><span>et d’autres…</span></li>
  </ul>

  <div class="column centered clients__outro">
    <p class="prose" data-reveal>
      De Verviers à l’international, j’ai collaboré avec des artisans, des PME et des sociétés actives dans plusieurs
      pays.
    </p>
    <p class="prose" data-reveal>
      L’endroit où vous êtes compte moins que ce que vous créez, <span class="soft">et la façon dont vous le créez.</span>
    </p>
    <div class="clients__icon">
      <AppIcon size={92} />
    </div>
    <p class="prose" data-reveal>
      Mon objectif : créer un travail qui compte, avec celles et ceux qui accordent autant d’importance que moi au
      détail, à l’intention et à l’exécution.
    </p>
    <p class="prose">
      <a class="link" href="#contact">Si c’est votre cas, parlons-en.</a>
    </p>
  </div>
</section>

<style>
  .clients__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 60rem;
    margin-block: clamp(48px, 7vw, 88px);
    border-top: 1px solid var(--line);
  }

  .clients__item {
    position: relative;
    display: grid;
    min-height: clamp(96px, 10vw, 124px);
    border-bottom: 1px solid var(--line);
  }

  .clients__item:not(:nth-child(4n)) {
    border-right: 1px solid var(--line);
  }

  .clients__item:hover,
  .clients__item:focus-within {
    z-index: 2;
  }

  .client {
    position: relative;
    display: grid;
    place-items: center;
    padding: 12px;
    outline-offset: -2px;
  }

  .client__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: clamp(1.0625rem, 1.7vw, 1.4375rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    color: #5f5f69;
    text-align: center;
    transition:
      opacity 0.45s var(--ease-out),
      filter 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .client__brand :global(.client__logo) {
    width: auto;
    max-width: 150px;
    height: clamp(34px, 3.8vw, 52px);
    object-fit: contain;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.78;
  }

  .client__brand :global(.client__icon) {
    width: auto;
    height: 1.15em;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.8;
  }

  .client__card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    max-width: 280px;
    padding: 10px 18px 10px 10px;
    border-radius: 18px;
    background: rgb(22 22 26 / 0.66);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.12) inset,
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 24px 50px -20px rgb(11 11 16 / 0.6);
    color: #fff;
    text-align: left;
    opacity: 0;
    transform: translate(-50%, -38%) scale(0.92);
    filter: blur(6px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out),
      filter 0.45s var(--ease-out);
  }

  .client__card :global(.client__thumb) {
    width: 64px;
    height: 48px;
    flex: none;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .client__meta {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .client__title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .client__tags {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.65);
  }

  .client__cta {
    position: absolute;
    left: 50%;
    top: calc(50% + 40px);
    padding: 7px 14px;
    border-radius: 999px;
    background: rgb(245 245 247 / 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--ink-80);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.9) inset,
      0 10px 24px -12px rgb(11 11 16 / 0.35);
    opacity: 0;
    transform: translate(-50%, -6px);
    filter: blur(4px);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out) 0.05s,
      transform 0.45s var(--ease-out) 0.05s,
      filter 0.45s var(--ease-out) 0.05s;
  }

  @media (hover: hover) {
    .client:hover .client__brand,
    .client:focus-visible .client__brand {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(-20px);
    }

    .client:hover .client__card,
    .client:focus-visible .client__card {
      opacity: 1;
      transform: translate(-50%, -62%) scale(1);
      filter: blur(0);
    }

    .client:hover .client__cta,
    .client:focus-visible .client__cta {
      opacity: 1;
      transform: translate(-50%, 0);
      filter: blur(0);
    }
  }

  .clients__item--more span {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 12px;
  }

  .clients__item--more {
    font-size: clamp(1.0625rem, 1.7vw, 1.4375rem);
    text-align: center;
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: italic;
    color: var(--muted);
  }

  .clients__outro {
    display: grid;
    gap: 22px;
    justify-items: center;
  }

  .clients__icon {
    margin-block: clamp(28px, 5vw, 52px) clamp(12px, 2vw, 20px);
  }

  @media (max-width: 720px) {
    .clients__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .clients__item:not(:nth-child(4n)) {
      border-right: 0;
    }

    .clients__item:nth-child(odd) {
      border-right: 1px solid var(--line);
    }
  }
</style>
