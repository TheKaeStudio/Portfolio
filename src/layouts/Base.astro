---
import type { ImageMetadata } from 'astro';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource/vt323/latin-400.css';
import '@/styles/global.css';
import frauncesWoff from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import geistWoff from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import Seo from '@/components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const { bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang="fr-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2a22a8" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={frauncesWoff} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistWoff} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot name="header" />
    <main id="contenu">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
